@{
    ViewData["Title"] = "Password Reset";
}

<div class="container" style="max-width: 460px;">
    <!-- Wireframe Header "Authentica... Password reset" -->
    <div style="text-align: center; margin-bottom: 2.5rem;">
        <h1 style="font-size: 2.25rem; margin-bottom: 0.5rem;">Password Reset</h1>
        <p style="color: #666;">Recover your account access</p>
    </div>

    <form asp-action="Login" method="get" class="card" style="padding: 2.5rem;">
        <div class="form-group">
            <label class="form-label">Registered Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="name@example.com" required />
        </div>

        <button type="submit" class="btn btn-black btn-full">
            🔑 Send Password Reset Email
        </button>

        <div style="text-align: center; margin-top: 1.5rem; font-size: 0.85rem;">
            Remembered your password? <a asp-action="Login" style="color: #4A3525; font-weight: 600;">Back to login</a>
        </div>
    </form>
</div>
