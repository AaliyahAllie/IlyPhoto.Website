@{
    ViewData["Title"] = "Make Booking";
    var services = ViewBag.Services as List<IlyPhotoWeb.Models.ServicePackage> ?? new List<IlyPhotoWeb.Models.ServicePackage>();
    string selectedSrv = ViewBag.SelectedService as string ?? "Pre-Wedding";
    string? error = ViewBag.Error as string;
    bool success = ViewBag.Success == true;
}

<div class="container" style="max-width: 850px;">
    <!-- Wireframe Header "Client / Booking" -->
    <div style="text-align: center; margin-bottom: 2.5rem;">
        <h1 style="font-size: 2.25rem; margin-bottom: 0.5rem;">Booking</h1>
        <p style="color: #666;">Choose a service & schedule your appointment</p>
    </div>

    @if (success)
    {
        <div class="card" style="text-align: center; padding: 3rem 2rem; background-color: #E8F5E9; border-color: #2D6A4F;">
            <div style="font-size: 3rem; margin-bottom: 0.5rem;">✓</div>
            <h2 style="color: #2D6A4F; margin-bottom: 0.5rem;">Booking Request Submitted!</h2>
            <p style="color: #333;">Your appointment request has been recorded. The photographer will review and confirm your session shortly.</p>
            <a asp-action="Dashboard" class="btn btn-black btn-sm" style="margin-top: 1rem;">View My Bookings</a>
        </div>
    }
    else
    {
        <!-- Fancy Multi-Month Availability Calendar Widget -->
        <div class="calendar-container">
            <div class="calendar-header" style="flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h3 style="margin: 0; color: #4A3525;">📅 Photographer Availability Calendar</h3>
                    <span style="font-size: 0.8rem; color: #666;">Browse availability across all months of the year</span>
                </div>
                
                <!-- Multi-Month Navigation Controls -->
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="changeMonth(-1)">◀ Prev Month</button>
                    <select id="monthSelect" class="form-control" style="width: auto; padding: 0.35rem; font-weight: 700;" onchange="renderCalendar()">
                        <option value="1">January 2026</option>
                        <option value="2">February 2026</option>
                        <option value="3">March 2026</option>
                        <option value="4">April 2026</option>
                        <option value="5">May 2026</option>
                        <option value="6">June 2026</option>
                        <option value="7">July 2026</option>
                        <option value="8">August 2026</option>
                        <option value="9">September 2026</option>
                        <option value="10" selected>October 2026</option>
                        <option value="11">November 2026</option>
                        <option value="12">December 2026</option>
                    </select>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="changeMonth(1)">Next Month ▶</button>
                </div>
            </div>

            <div class="calendar-grid" style="margin-top: 1rem;">
                <div class="calendar-day-head">Sun</div>
                <div class="calendar-day-head">Mon</div>
                <div class="calendar-day-head">Tue</div>
                <div class="calendar-day-head">Wed</div>
                <div class="calendar-day-head">Thu</div>
                <div class="calendar-day-head">Fri</div>
                <div class="calendar-day-head">Sat</div>

                <div id="calendarDaysContainer" style="display: contents;"></div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="padding: 0.85rem; background-color: #FEE2E2; border: 1px solid #991B1B; border-radius: 6px; color: #991B1B; font-size: 0.88rem; margin-bottom: 1.25rem;">
                ⚠️ @error
            </div>
        }

        <form asp-action="Booking" method="post" class="card" style="padding: 2.5rem;">
            <div class="form-group">
                <label class="form-label">Select Photography Service / Package *</label>
                <select name="serviceName" class="form-control" required>
                    @foreach (var s in services)
                    {
                        <option value="@s.Name" selected="@(selectedSrv == s.Name ? "selected" : null)">
                            @s.Name - R@s.Price (@s.Duration)
                        </option>
                    }
                </select>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label class="form-label">Preferred Date *</label>
                    <input type="date" name="eventDate" id="bookingDateInput" class="form-control" value="2026-10-18" required />
                </div>

                <div class="form-group">
                    <label class="form-label">Preferred Time *</label>
                    <input type="time" name="eventTime" class="form-control" value="14:00" required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Event Location *</label>
                <input type="text" name="location" class="form-control" placeholder="Venue name or physical address" required />
            </div>

            <div class="form-group">
                <label class="form-label">Special Requirements / Notes</label>
                <textarea name="requirements" class="form-control" placeholder="Lighting preferences, outfit counts, family members included..."></textarea>
            </div>

            <button type="submit" class="btn btn-black btn-full">
                📅 Submit Appointment Request
            </button>
        </form>
    }
</div>

<script>
    const bookedDates = {
        '2026-10-05': '11:00 Booked',
        '2026-10-15': '14:00 Booked',
        '2026-10-25': '14:00 Booked',
        '2026-11-10': '10:00 Booked',
        '2026-12-05': '15:00 Booked'
    };

    function renderCalendar() {
        const select = document.getElementById('monthSelect');
        const month = parseInt(select.value);
        const year = 2026;
        const daysInMonth = new Date(year, month, 0).getDate();
        const container = document.getElementById('calendarDaysContainer');
        container.innerHTML = '';

        for (let day = 1; day <= daysInMonth; day++) {
            const dateStr = `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
            const isBooked = bookedDates[dateStr];
            
            const cell = document.createElement('div');
            cell.className = 'calendar-day-cell' + (isBooked ? ' is-booked' : '');
            cell.onclick = function() {
                document.getElementById('bookingDateInput').value = dateStr;
            };
            cell.style.cursor = 'pointer';

            let cellHtml = `<div style="display:flex; justify-content:space-between; width:100%;"><span class="calendar-day-num">${day}</span></div>`;
            if (isBooked) {
                cellHtml += `<span class="calendar-day-tag">${isBooked}</span>`;
            } else {
                cellHtml += `<span style="font-size:0.7rem; color:#2D6A4F;">Available</span>`;
            }

            cell.innerHTML = cellHtml;
            container.appendChild(cell);
        }
    }

    function changeMonth(delta) {
        const select = document.getElementById('monthSelect');
        let current = parseInt(select.value) + delta;
        if (current < 1) current = 12;
        if (current > 12) current = 1;
        select.value = current;
        renderCalendar();
    }

    document.addEventListener('DOMContentLoaded', renderCalendar);
</script>
