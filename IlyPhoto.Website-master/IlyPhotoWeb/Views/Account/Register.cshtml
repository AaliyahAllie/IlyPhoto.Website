@model RegisterViewModel
@{ 
    ViewData["Title"] = "Register Client Account"; 
}

<section class="auth-wrap" style="padding: 3rem 1rem; min-height: 75vh; display: flex; align-items: center; justify-content: center;">
  <div class="card" style="max-width: 460px; width: 100%; padding: 2.5rem; background: var(--card-bg, #FFFFFF); border: 1px solid #D1C7B7; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="~/images/logo.png" alt="ILY PHOTO" style="height: 60px; object-fit: contain; margin-bottom: 0.5rem;"/>
      <p style="font-size: 0.85rem; letter-spacing: 0.1em; color: #4A3525; text-transform: uppercase; font-weight: 700; margin: 0;">CLIENT REGISTRATION</p>
      <h1 style="font-size: 1.9rem; font-weight: 700; color: #1A1A1A; margin: 0.5rem 0 0 0;">Create Your Account</h1>
    </div>

    <div asp-validation-summary="All" class="form-errors" style="color: #922B21; font-size: 0.92rem; font-weight: 600; margin-bottom: 1rem;"></div>

    <form method="post" asp-controller="Account" asp-action="Register">
      <div class="form-group" style="margin-bottom: 1.2rem;">
        <label asp-for="FullName" class="form-label" style="display: block; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; color: #1A1A1A;">Full Name</label>
        <input asp-for="FullName" required autocomplete="name" class="form-control" placeholder="Jane Doe" style="width: 100%; padding: 0.8rem; border: 1px solid #8C7A6B; border-radius: 4px; font-size: 1rem; color: #1A1A1A;"/>
      </div>

      <div class="form-group" style="margin-bottom: 1.2rem;">
        <label asp-for="Email" class="form-label" style="display: block; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; color: #1A1A1A;">Email Address</label>
        <input asp-for="Email" type="email" required autocomplete="email" class="form-control" placeholder="client@example.com" style="width: 100%; padding: 0.8rem; border: 1px solid #8C7A6B; border-radius: 4px; font-size: 1rem; color: #1A1A1A;"/>
      </div>

      <div class="form-group" style="margin-bottom: 1.2rem;">
        <label asp-for="Phone" class="form-label" style="display: block; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; color: #1A1A1A;">Phone / WhatsApp</label>
        <input asp-for="Phone" type="tel" autocomplete="tel" class="form-control" placeholder="+27 82 000 0000" style="width: 100%; padding: 0.8rem; border: 1px solid #8C7A6B; border-radius: 4px; font-size: 1rem; color: #1A1A1A;"/>
      </div>

      <div class="form-group" style="margin-bottom: 1.2rem;">
        <label asp-for="Password" class="form-label" style="display: block; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; color: #1A1A1A;">Password (at least 6 characters)</label>
        <input asp-for="Password" type="password" required minlength="6" autocomplete="new-password" class="form-control" placeholder="••••••••" style="width: 100%; padding: 0.8rem; border: 1px solid #8C7A6B; border-radius: 4px; font-size: 1rem; color: #1A1A1A;"/>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label asp-for="ConfirmPassword" class="form-label" style="display: block; font-size: 0.95rem; font-weight: 700; margin-bottom: 0.4rem; color: #1A1A1A;">Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" required minlength="6" autocomplete="new-password" class="form-control" placeholder="••••••••" style="width: 100%; padding: 0.8rem; border: 1px solid #8C7A6B; border-radius: 4px; font-size: 1rem; color: #1A1A1A;"/>
      </div>

      <button class="btn btn-primary btn-block" type="submit" style="width: 100%; padding: 0.9rem; font-size: 1rem; font-weight: 700; cursor: pointer;">Register Account</button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; border-top: 1px solid #D1C7B7; padding-top: 1.25rem; font-size: 0.95rem; color: #2C2C2C;">
      Already registered? <a asp-action="Login" style="color: #4A3525; font-weight: 700; text-decoration: underline;">Sign In here</a>
    </div>
  </div>
</section>
