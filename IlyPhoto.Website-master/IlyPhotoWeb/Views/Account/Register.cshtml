@model RegisterViewModel
@{ 
    ViewData["Title"] = "Register Client Account"; 
}

<section class="auth-wrap" style="padding: 3rem 1rem; min-height: 75vh; display: flex; align-items: center; justify-content: center;">
  <div class="card" style="max-width: 460px; width: 100%; padding: 2.5rem; background: #FFFFFF; border: 1px solid #E2DACB; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="~/images/logo.png" alt="ILY PHOTO" style="height: 60px; object-fit: contain; margin-bottom: 0.5rem;"/>
      <p style="font-size: 0.75rem; letter-spacing: 0.1em; color: #7A6B5D; text-transform: uppercase; font-weight: 700; margin: 0;">CLIENT REGISTRATION</p>
      <h1 style="font-size: 1.8rem; font-weight: 700; color: #1A1A1A; margin: 0.5rem 0 0 0;">Create Your Account</h1>
    </div>

    <div asp-validation-summary="All" class="form-errors" style="color: #A93226; font-size: 0.88rem; margin-bottom: 1rem;"></div>

    <form method="post" asp-controller="Account" asp-action="Register">
      <div class="form-group" style="margin-bottom: 1.1rem;">
        <label asp-for="FullName" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.35rem; color: #4A3525;">Full Name</label>
        <input asp-for="FullName" required autocomplete="name" class="form-control" placeholder="Jane Doe" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; font-size: 0.95rem;"/>
      </div>

      <div class="form-group" style="margin-bottom: 1.1rem;">
        <label asp-for="Email" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.35rem; color: #4A3525;">Email Address</label>
        <input asp-for="Email" type="email" required autocomplete="email" class="form-control" placeholder="client@example.com" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; font-size: 0.95rem;"/>
      </div>

      <div class="form-group" style="margin-bottom: 1.1rem;">
        <label asp-for="Phone" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.35rem; color: #4A3525;">Phone / WhatsApp</label>
        <input asp-for="Phone" type="tel" autocomplete="tel" class="form-control" placeholder="+27 82 000 0000" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; font-size: 0.95rem;"/>
      </div>

      <div class="form-group" style="margin-bottom: 1.1rem;">
        <label asp-for="Password" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.35rem; color: #4A3525;">Password (at least 6 characters)</label>
        <input asp-for="Password" type="password" required autocomplete="new-password" class="form-control" placeholder="••••••••" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; font-size: 0.95rem;"/>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label asp-for="ConfirmPassword" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.35rem; color: #4A3525;">Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" required autocomplete="new-password" class="form-control" placeholder="••••••••" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; font-size: 0.95rem;"/>
      </div>

      <button class="btn btn-primary btn-block" type="submit" style="width: 100%; padding: 0.85rem; font-size: 1rem; font-weight: 700; cursor: pointer;">Register Account</button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; border-top: 1px solid #ECE4D8; padding-top: 1.25rem; font-size: 0.88rem; color: #666;">
      Already registered? <a asp-action="Login" style="color: #4A3525; font-weight: 700; text-decoration: underline;">Sign In here</a>
    </div>
  </div>
</section>
