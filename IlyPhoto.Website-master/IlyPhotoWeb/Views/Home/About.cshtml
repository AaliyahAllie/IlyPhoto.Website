@{ 
    ViewData["Title"] = "About ILY Photo & Community Mission"; 
}

<div class="container" style="padding: 2.5rem 1rem;">
  <div style="text-align: center; margin-bottom: 3rem;">
    <p style="font-size: 0.85rem; letter-spacing: 0.1em; color: #4A3525; text-transform: uppercase; font-weight: 700; margin: 0;">BEHIND THE CAMERA &amp; COMMUNITY MISSION</p>
    <h1 style="font-size: 2.5rem; font-weight: 700; color: #1A1A1A; margin: 0.35rem 0 0.5rem 0;">About ILY Photo</h1>
    <p style="color: #3D3D3D; max-width: 680px; margin: 0 auto;">Founded and operated by solo photographer Aysha Allie in Strandfontein, Cape Town — combining studio excellence with grass-roots community empowerment.</p>
  </div>

  <div class="about-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; margin-bottom: 3rem;">
    <div class="card" style="padding: 2rem; background: #FAF7F2; border: 1px solid #E2DACB; border-radius: 8px; text-align: center;">
      <img src="~/images/logo.png" alt="ILY PHOTO" style="max-width: 260px; width: 100%; object-fit: contain; margin-bottom: 1.5rem;"/>
      <div style="font-family: var(--font-serif); font-size: 1.4rem; color: #4A3525; margin-bottom: 0.5rem;">Aysha Allie</div>
      <p style="color: #4A3525; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700;">Owner, Principal Photographer &amp; Youth Mentor</p>
      <div style="display: flex; justify-content: center; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem;">
        <span class="badge" style="background: #EAE3D2; color: #2C1E14; font-weight: 700;">Strandfontein, Cape Town</span>
        <span class="badge" style="background: #EAE3D2; color: #2C1E14; font-weight: 700;">Matric Balls &amp; Schools</span>
        <span class="badge" style="background: #EAE3D2; color: #2C1E14; font-weight: 700;">Weddings</span>
        <span class="badge" style="background: #EAE3D2; color: #2C1E14; font-weight: 700;">NGO &amp; NPO Partner</span>
      </div>
    </div>

    <div>
      <h2 style="color: #4A3525; font-size: 1.8rem; margin-top: 0;">A Personal Journey &amp; Community Purpose In Every Frame</h2>
      <p style="color: #2C2C2C; font-size: 1rem; line-height: 1.8; margin-bottom: 1rem;">
        ILY Photo is an independent Cape Town photography studio and social-enterprise partner dedicated to capturing genuine emotion, natural light, and heartfelt celebrations. Every client journey — from initial booking to final gallery delivery — is handled personally with care and artistic precision.
      </p>
      <p style="color: #2C2C2C; font-size: 1rem; line-height: 1.8; margin-bottom: 1rem;">
        <strong>Substantiating Our NGO &amp; Community Need:</strong> Across Strandfontein and the Cape Flats, local non-profits, youth clubs, and public schools frequently struggle to afford professional visual media for donor accountability, community heritage archiving, and matric celebrations. ILY Photo bridges this gap through subsidized NGO packages, pro-bono charity event slots, and hands-on youth photography mentorship.
      </p>
      <p style="color: #2C2C2C; font-size: 1rem; line-height: 1.8; margin-bottom: 1.5rem;">
        Through this unified Azure cloud platform (synchronized across Desktop Web and Android Mobile), clients and community partners can check real-time availability, request or reschedule bookings, receive automated EFT invoices, and download private cloud-backed photo collections.
      </p>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
        <a asp-action="Pricing" class="btn btn-primary" style="text-decoration: none;">Explore Packages</a>
        <a asp-action="Contact" class="btn btn-outline" style="text-decoration: none;">Partner With Us</a>
      </div>
    </div>
  </div>
</div>
