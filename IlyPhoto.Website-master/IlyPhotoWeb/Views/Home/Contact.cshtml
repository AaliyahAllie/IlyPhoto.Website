@model ContactViewModel
@{
    ViewData["Title"] = "Contact Us";
}

<div class="container" style="padding: 2.5rem 1rem;">
    <div style="text-align: center; margin-bottom: 3rem;">
        <p style="font-size: 0.75rem; letter-spacing: 0.1em; color: #7A6B5D; text-transform: uppercase; font-weight: 700; margin: 0;">GET IN TOUCH</p>
        <h1 style="font-size: 2.5rem; font-weight: 700; color: #1A1A1A; margin: 0.35rem 0 0.5rem 0;">Contact ILY Photo</h1>
        <p style="color: #666; max-width: 600px; margin: 0 auto;">Have questions about our sessions, packages, or availability? Send us a message.</p>
    </div>

    <div style="max-width: 650px; margin: 0 auto;">
        @if (TempData["ContactSuccess"] is string msg)
        {
            <div class="card" style="text-align: center; padding: 2.5rem 2rem; background-color: #E8F8F5; border: 1px solid #A2D9CE; border-radius: 8px; margin-bottom: 2rem;">
                <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">✓</div>
                <h3 style="color: #117A65; margin: 0 0 0.5rem 0;">Enquiry Received!</h3>
                <p style="color: #333; margin: 0; font-size: 0.95rem;">
                    @msg
                </p>
            </div>
        }

        <form asp-action="Contact" method="post" class="card" style="padding: 2.5rem; background: #FFF; border: 1px solid #E2DACB; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
            <div asp-validation-summary="All" style="color: #A93226; font-size: 0.88rem; margin-bottom: 1rem;"></div>

            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label asp-for="FullName" style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Full Name *</label>
                <input asp-for="FullName" class="form-control" placeholder="Your Name" required style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px;" />
            </div>

            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label asp-for="Email" style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Email Address *</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px;" />
            </div>

            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label asp-for="Phone" style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Phone / WhatsApp</label>
                <input asp-for="Phone" type="tel" class="form-control" placeholder="+27 82 000 0000" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px;" />
            </div>

            <div class="form-group" style="margin-bottom: 1.5rem;">
                <label asp-for="Message" style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Enquiry Message *</label>
                <textarea asp-for="Message" rows="5" class="form-control" placeholder="Tell us about your event, preferred date, or photography questions..." required style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; resize: vertical;"></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="width: 100%; padding: 0.85rem; font-weight: 700; cursor: pointer;">
                ✈️ Send Message
            </button>
        </form>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.5rem; text-align: center;">
            <div class="card" style="padding: 1.25rem; background: #FFF; border: 1px solid #E2DACB; border-radius: 6px;">
                <div style="font-size: 1.5rem; margin-bottom: 0.35rem;">✉️</div>
                <h4 style="font-size: 0.9rem; margin-bottom: 0.2rem; color: #4A3525;">Email</h4>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">info@ilyphoto.co.za</p>
            </div>
            <div class="card" style="padding: 1.25rem; background: #FFF; border: 1px solid #E2DACB; border-radius: 6px;">
                <div style="font-size: 1.5rem; margin-bottom: 0.35rem;">📞</div>
                <h4 style="font-size: 0.9rem; margin-bottom: 0.2rem; color: #4A3525;">Phone</h4>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">+27 82 123 4567</p>
            </div>
            <div class="card" style="padding: 1.25rem; background: #FFF; border: 1px solid #E2DACB; border-radius: 6px;">
                <div style="font-size: 1.5rem; margin-bottom: 0.35rem;">📍</div>
                <h4 style="font-size: 0.9rem; margin-bottom: 0.2rem; color: #4A3525;">Location</h4>
                <p style="font-size: 0.8rem; color: #666; margin: 0;">Cape Town, South Africa</p>
            </div>
        </div>
    </div>
</div>
