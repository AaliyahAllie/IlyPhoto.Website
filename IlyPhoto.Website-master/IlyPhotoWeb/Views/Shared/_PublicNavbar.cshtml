<header class="site-navbar" style="background-color: #FDFBF7; border-bottom: 1px solid #E2DACB; position: sticky; top: 0; z-index: 100; padding: 0.75rem 0;">
    <div class="container navbar-flex" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
        <a asp-controller="Home" asp-action="Index" style="display: flex; align-items: center; text-decoration: none;">
            <img src="~/images/logo.png" alt="Ily Photo - Capture Forever" style="height: 52px; object-fit: contain;" />
        </a>

        <nav>
            <ul style="display: flex; align-items: center; gap: 1.35rem; list-style: none; margin: 0; padding: 0; flex-wrap: wrap;">
                <li><a asp-controller="Home" asp-action="Index" class="nav-link" data-i18n="nav_home">Home</a></li>
                <li><a asp-controller="Home" asp-action="About" class="nav-link" data-i18n="nav_about">About &amp; NGO</a></li>
                <li><a asp-controller="Home" asp-action="Portfolio" class="nav-link" data-i18n="nav_portfolio">Portfolio</a></li>
                <li><a asp-controller="Home" asp-action="Pricing" class="nav-link" data-i18n="nav_pricing">Pricing</a></li>
                <li><a asp-controller="Home" asp-action="Contact" class="nav-link" data-i18n="nav_contact">Contact Us</a></li>
            </ul>
        </nav>

        <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
            <select aria-label="Language Selector" class="lang-selector" onchange="setLanguage(this.value)" style="padding: 0.35rem 0.5rem; border: 1px solid #8C7A6B; border-radius: 4px; background: #FFF; color: #1A1A1A; font-size: 0.85rem; font-weight: 600;">
                <option value="en">EN (English)</option>
                <option value="af">AF (Afrikaans)</option>
            </select>
            <button type="button" class="btn btn-outline btn-sm theme-toggle-btn" onclick="toggleDarkMode()" aria-label="Toggle Dark Mode" style="padding: 0.35rem 0.65rem;">
                🌙 Dark
            </button>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline btn-sm" data-i18n="nav_signin">Sign In</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm" data-i18n="nav_register">Register</a>
        </div>
    </div>
</header>
