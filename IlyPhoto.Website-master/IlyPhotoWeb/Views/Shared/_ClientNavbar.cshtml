@{
    var clientName = User.Identity?.Name ?? "Client";
}

<header class="site-navbar" style="background-color: #FAF7F2; border-bottom: 2px solid #4A3525; position: sticky; top: 0; z-index: 100; padding: 0.75rem 0;">
    <div class="container navbar-flex" style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
        <a asp-controller="Client" asp-action="Index" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none;">
            <img src="~/images/logo.png" alt="Ily Photo - Capture Forever" style="height: 52px; object-fit: contain;" />
            <span style="font-size: 0.8rem; background-color: #4A3525; color: #FFF; padding: 0.25rem 0.65rem; border-radius: 4px; font-weight: 700; letter-spacing: 0.05em;">CLIENT PORTAL</span>
        </a>

        <nav>
            <ul style="display: flex; align-items: center; gap: 1.25rem; list-style: none; margin: 0; padding: 0; flex-wrap: wrap;">
                <li><a asp-controller="Client" asp-action="Index" class="nav-link" data-i18n="nav_dashboard">Dashboard</a></li>
                <li><a asp-controller="Client" asp-action="Bookings" class="nav-link" data-i18n="nav_book">Book Session</a></li>
                <li><a asp-controller="Client" asp-action="Gallery" class="nav-link" data-i18n="nav_gallery">My Private Gallery</a></li>
                <li><a asp-controller="Client" asp-action="Invoices" class="nav-link" data-i18n="nav_invoices">Invoices</a></li>
                <li><a asp-controller="Client" asp-action="Reviews" class="nav-link" data-i18n="nav_reviews">Reviews</a></li>
                <li><a asp-controller="Client" asp-action="Profile" class="nav-link" data-i18n="nav_profile">Profile</a></li>
            </ul>
        </nav>

        <div style="display: flex; gap: 0.6rem; align-items: center; flex-wrap: wrap;">
            <select aria-label="Language Selector" class="lang-selector" onchange="setLanguage(this.value)" style="padding: 0.35rem 0.5rem; border: 1px solid #8C7A6B; border-radius: 4px; background: #FFF; color: #1A1A1A; font-size: 0.85rem; font-weight: 600;">
                <option value="en">EN</option>
                <option value="af">AF</option>
            </select>
            <button type="button" class="btn btn-outline btn-sm theme-toggle-btn" onclick="toggleDarkMode()" aria-label="Toggle Dark Mode" style="padding: 0.35rem 0.65rem;">
                🌙 Dark
            </button>
            <span style="font-size: 0.9rem; color: #4A3525; font-weight: 700;">👤 @clientName</span>
            <form method="post" asp-controller="Account" asp-action="Logout" style="display: inline; margin: 0;">
                <button type="submit" class="btn btn-secondary btn-sm" style="cursor: pointer;" data-i18n="nav_logout">Logout</button>
            </form>
        </div>
    </div>
</header>
