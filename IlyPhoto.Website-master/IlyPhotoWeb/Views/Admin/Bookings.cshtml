@model AdminBookingsViewModel
@{ 
    ViewData["Title"] = "Manage Bookings & Availability"; 
}

<div class="container" style="padding: 2.5rem 1rem;">
  <section class="dashboard-head">
    <div>
      <p style="font-size: 0.85rem; letter-spacing: 0.1em; color: #4A3525; text-transform: uppercase; font-weight: 700; margin: 0;">ADMIN CALENDAR</p>
      <h1 style="font-size: 2.5rem; font-weight: 700; color: #1A1A1A; margin: 0.35rem 0 0.5rem 0;">Bookings &amp; Calendar</h1>
      <p style="color: #3D3D3D; margin: 0;">Click an open day on the calendar to block it, or a blocked day to make it available again.</p>
    </div>
    <button class="btn btn-primary" type="button" onclick="document.getElementById('blockDialog').showModal()" style="padding: 0.75rem 1.25rem;">
      🚫 Block A Date
    </button>
  </section>

  <section class="booking-layout">
    <!-- Photographer Master Multi-Month Calendar -->
    <div class="card" style="background: #FFF; border: 1px solid #E2DACB; border-radius: 8px; padding: 1.5rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
      <div class="calendar-toolbar">
        <button type="button" class="btn btn-outline btn-sm" onclick="changeMonth(-1)">← Prev Month</button>
        <h2 id="calendarTitle" style="margin: 0; font-size: 1.25rem; color: #4A3525;"></h2>
        <button type="button" class="btn btn-outline btn-sm" onclick="changeMonth(1)">Next Month →</button>
      </div>

      <div id="calendarStatusNotice" style="display: none; margin-bottom: 0.75rem; padding: 0.65rem 0.85rem; border-radius: 4px; background: #FEF9E7; border: 1px solid #F9E79F; color: #7D6608; font-size: 0.88rem; font-weight: 600;"></div>
      <div id="calendar" class="calendar admin-calendar"></div>

      <div class="legend" style="margin-top: 1.25rem;">
        <span><i class="dot available"></i>Available</span>
        <span><i class="dot busy"></i>Confirmed / Rescheduled</span>
        <span><i class="dot blocked"></i>Blocked Date</span>
      </div>
      <p style="font-size: 0.88rem; color: #3D3D3D; margin-top: 0.75rem;">💡 Tip: Click any day to quick-block or unblock it.</p>
    </div>

    <!-- Booking Requests -->
    <div class="card" style="background: #FFF; border: 1px solid #E2DACB; border-radius: 8px; padding: 1.75rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
      <h2 style="font-size: 1.35rem; color: #4A3525; margin-top: 0; margin-bottom: 1.25rem;">Pending Requests (@Model.Pending.Count)</h2>
      @if (Model.Pending.Count == 0)
      {
        <p style="color: #3D3D3D;">No pending booking requests at this time.</p>
      }
      @foreach (var b in Model.Pending)
      {
        <div class="request-card" style="border-top: 1px solid #ECE4D8; padding: 1rem 0;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <h3 style="margin: 0; font-size: 1.15rem; color: #1A1A1A;">@b.EventType</h3>
            <span class="status pending">Pending Approval</span>
          </div>
          <p style="margin: 0.25rem 0; font-size: 0.92rem; color: #2C2C2C;"><strong>Client:</strong> @b.ClientName (@b.ClientId)</p>
          <p style="margin: 0.25rem 0; font-size: 0.92rem; color: #2C2C2C;"><strong>Date &amp; Time:</strong> @Format.Date(b.Date) • @b.StartTime – @b.EndTime (@b.Hours h)</p>
          <p style="margin: 0.25rem 0; font-size: 0.92rem; color: #2C2C2C;"><strong>Venue / Location:</strong> @b.Location</p>
          <p style="margin: 0.25rem 0; font-size: 0.92rem; color: #4A3525; font-weight: 700;"><strong>Estimated Total:</strong> @Format.Rand(b.EstimatedTotal)</p>
          @if (!string.IsNullOrWhiteSpace(b.Notes))
          {
            <p style="margin: 0.35rem 0; font-size: 0.88rem; color: #4A3525; font-style: italic;">Notes: "@b.Notes"</p>
          }

          <div style="display: flex; gap: 0.5rem; margin-top: 0.85rem; flex-wrap: wrap;">
            <form method="post" asp-controller="Admin" asp-action="ApproveBooking" style="margin: 0;">
              <input type="hidden" name="id" value="@b.Id" />
              <input type="hidden" name="returnTo" value="Bookings" />
              <button class="btn btn-primary btn-sm" type="submit" style="cursor: pointer;">✓ Approve &amp; Invoice</button>
            </form>
            <form method="post" asp-controller="Admin" asp-action="DenyBooking" style="margin: 0;">
              <input type="hidden" name="id" value="@b.Id" />
              <input type="hidden" name="returnTo" value="Bookings" />
              <button class="btn btn-outline btn-sm" type="submit" style="color: #922B21; cursor: pointer;">✕ Deny</button>
            </form>
            <button type="button"
                    class="btn btn-secondary btn-sm"
                    data-id="@b.Id"
                    data-date="@b.Date"
                    data-start="@b.StartTime"
                    data-end="@b.EndTime"
                    data-location="@b.Location"
                    data-notes="@b.Notes"
                    onclick="openReschedule(this)"
                    style="cursor: pointer;">
              🔄 Reschedule
            </button>
          </div>
        </div>
      }
    </div>
  </section>

  <!-- Confirmed & Rescheduled Events -->
  <div class="card" style="background: #FFF; border: 1px solid #E2DACB; border-radius: 8px; padding: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
    <h2 style="font-size: 1.4rem; color: #4A3525; margin-top: 0; margin-bottom: 1.25rem;">Upcoming Confirmed &amp; Rescheduled Events</h2>
    @if (Model.Upcoming.Count == 0)
    {
      <p style="color: #3D3D3D; margin: 0;">No confirmed shoots scheduled yet.</p>
    }
    else
    {
      <div class="table-wrap">
        <table class="table" style="width: 100%; border-collapse: collapse;">
          <thead>
            <tr style="background-color: #FAF7F2; border-bottom: 2px solid #E2DACB; text-align: left;">
              <th style="padding: 12px;">Event Date</th>
              <th style="padding: 12px;">Time</th>
              <th style="padding: 12px;">Package</th>
              <th style="padding: 12px;">Client</th>
              <th style="padding: 12px;">Venue / Location</th>
              <th style="padding: 12px;">Status</th>
              <th style="padding: 12px; text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
          @foreach (var b in Model.Upcoming)
          {
            <tr style="border-bottom: 1px solid #ECE4D8;">
              <td style="padding: 12px; font-weight: 700;">@Format.Date(b.Date)</td>
              <td style="padding: 12px;">@b.StartTime – @b.EndTime (@b.Hours h)</td>
              <td style="padding: 12px; font-weight: 600;">@b.EventType</td>
              <td style="padding: 12px;">@b.ClientName <small style="color: #4A3525; font-weight: 600;">(@b.ClientId)</small></td>
              <td style="padding: 12px;">@b.Location</td>
              <td style="padding: 12px;"><span class="status @Format.StatusClass(b.Status)">@b.Status</span></td>
              <td style="padding: 12px; text-align: right; display: flex; justify-content: flex-end; gap: 0.5rem; flex-wrap: wrap;">
                <button type="button"
                        class="btn btn-outline btn-sm"
                        data-id="@b.Id"
                        data-date="@b.Date"
                        data-start="@b.StartTime"
                        data-end="@b.EndTime"
                        data-location="@b.Location"
                        data-notes="@b.Notes"
                        onclick="openReschedule(this)">
                  Reschedule / Edit
                </button>
                <form method="post" asp-controller="Admin" asp-action="CompleteBooking" style="margin: 0; display: inline;">
                  <input type="hidden" name="id" value="@b.Id" />
                  <input type="hidden" name="returnTo" value="Bookings" />
                  <button type="submit" class="btn btn-primary btn-sm">✓ Complete</button>
                </form>
              </td>
            </tr>
          }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>

<!-- Block Date Modal Dialog -->
<dialog id="blockDialog" style="border: 0; border-radius: 8px; padding: 0; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
  <form method="post" asp-controller="Admin" asp-action="BlockDate" class="dialog-card">
    <h2 style="color: #4A3525; margin-top: 0;">Block Date Availability</h2>
    <div class="form-group" style="margin-bottom: 1rem;">
      <label for="blockDate" style="display: block; font-size: 0.92rem; font-weight: 700; color: #2C1E14; margin-bottom: 0.35rem;">Date to Block</label>
      <input type="date" name="date" id="blockDate" class="form-control" required style="width: 100%; padding: 0.65rem; border: 1px solid #8C7A6B; border-radius: 4px;"/>
    </div>
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label style="display: block; font-size: 0.92rem; font-weight: 700; color: #2C1E14; margin-bottom: 0.35rem;">Reason (Optional)</label>
      <input name="reason" maxlength="200" placeholder="e.g. Leave, Maintenance, Studio Shoot" class="form-control" style="width: 100%; padding: 0.65rem; border: 1px solid #8C7A6B; border-radius: 4px;"/>
    </div>
    <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
      <button class="btn btn-outline" type="button" onclick="this.closest('dialog').close()">Cancel</button>
      <button class="btn btn-primary" type="submit">Save Blocked Date</button>
    </div>
  </form>
</dialog>

<!-- Reschedule Modal Dialog -->
<dialog id="rescheduleDialog" style="border: 0; border-radius: 8px; padding: 0; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
  <form method="post" asp-controller="Admin" asp-action="RescheduleBooking" class="dialog-card">
    <h2 style="color: #4A3525; margin-top: 0;">Reschedule &amp; Update Booking</h2>
    <input type="hidden" name="id" id="reId"/>
    <input type="hidden" name="returnTo" value="Bookings"/>
    <div class="form-group" style="margin-bottom: 1rem;">
      <label for="reDate" style="display: block; font-size: 0.92rem; font-weight: 700; color: #2C1E14; margin-bottom: 0.35rem;">New Date</label>
      <input type="date" name="date" id="reDate" class="form-control" required style="width: 100%; padding: 0.65rem; border: 1px solid #8C7A6B; border-radius: 4px;"/>
    </div>
    <div class="two" style="margin-bottom: 1rem;">
      <div>
        <label for="reStart" style="display: block; font-size: 0.92rem; font-weight: 700; color: #2C1E14; margin-bottom: 0.35rem;">Start Time</label>
        <input type="time" name="startTime" id="reStart" class="form-control" required style="width: 100%; padding: 0.65rem; border: 1px solid #8C7A6B; border-radius: 4px;"/>
      </div>
      <div>
        <label for="reEnd" style="display: block; font-size: 0.92rem; font-weight: 700; color: #2C1E14; margin-bottom: 0.35rem;">End Time</label>
        <input type="time" name="endTime" id="reEnd" class="form-control" required style="width: 100%; padding: 0.65rem; border: 1px solid #8C7A6B; border-radius: 4px;"/>
      </div>
    </div>
    <div class="form-group" style="margin-bottom: 1rem;">
      <label for="reLocation" style="display: block; font-size: 0.92rem; font-weight: 700; color: #2C1E14; margin-bottom: 0.35rem;">Venue / Location</label>
      <input type="text" name="location" id="reLocation" class="form-control" placeholder="Event venue or suburb" style="width: 100%; padding: 0.65rem; border: 1px solid #8C7A6B; border-radius: 4px;"/>
    </div>
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="reNotes" style="display: block; font-size: 0.92rem; font-weight: 700; color: #2C1E14; margin-bottom: 0.35rem;">Updated Notes</label>
      <textarea name="notes" id="reNotes" rows="2" class="form-control" style="width: 100%; padding: 0.65rem; border: 1px solid #8C7A6B; border-radius: 4px;"></textarea>
    </div>
    <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
      <button class="btn btn-outline" type="button" onclick="this.closest('dialog').close()">Cancel</button>
      <button class="btn btn-primary" type="submit">Confirm Reschedule</button>
    </div>
  </form>
</dialog>

<form id="unblockForm" method="post" asp-controller="Admin" asp-action="UnblockDate">
  <input type="hidden" name="date" id="unblockDate"/>
</form>

@section Scripts {
<script>
  document.addEventListener('DOMContentLoaded', function() {
    initBookingCalendar(true);
  });
</script>
}
