@model List<Review>
@{ 
    ViewData["Title"] = "Client Reviews"; 
}

<div class="container" style="padding: 2.5rem 1rem;">
  <section class="dashboard-head">
    <div>
      <p style="font-size: 0.75rem; letter-spacing: 0.1em; color: #7A6B5D; text-transform: uppercase; font-weight: 700; margin: 0;">CLIENT FEEDBACK</p>
      <h1 style="font-size: 2.5rem; font-weight: 700; color: #1A1A1A; margin: 0.35rem 0 0.5rem 0;">Share Your Experience</h1>
      <p style="color: #666; margin: 0;">We value your thoughts! Tell us about your photography shoot with Aysha Allie.</p>
    </div>
  </section>

  <div style="max-width: 680px; margin: 0 auto;">
    <div class="card" style="background: #FFF; border: 1px solid #E2DACB; border-radius: 8px; padding: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03); margin-bottom: 2rem;">
      <h2 style="font-size: 1.3rem; color: #4A3525; margin-top: 0; margin-bottom: 1.25rem;">Submit A Review</h2>
      <div asp-validation-summary="All" class="form-errors"></div>

      <form method="post" asp-controller="Client" asp-action="Reviews">
        <div class="form-group" style="margin-bottom: 1.25rem;">
          <label style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Rating</label>
          <select name="rating" class="form-control" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; font-size: 1rem;">
            <option value="5">★★★★★ — 5 Stars (Exceptional)</option>
            <option value="4">★★★★☆ — 4 Stars (Very Good)</option>
            <option value="3">★★★☆☆ — 3 Stars (Satisfactory)</option>
            <option value="2">★★☆☆☆ — 2 Stars (Needs Improvement)</option>
            <option value="1">★☆☆☆☆ — 1 Star (Unsatisfactory)</option>
          </select>
        </div>

        <div class="form-group" style="margin-bottom: 1.5rem;">
          <label style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Your Feedback Comments *</label>
          <textarea name="review" rows="5" class="form-control" placeholder="Write about your experience, the photos, and the photographer's service..." required maxlength="2000" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; resize: vertical;"></textarea>
        </div>

        <button class="btn btn-primary btn-block" type="submit" style="width: 100%; padding: 0.85rem; font-weight: 700; cursor: pointer;">
          Submit Review
        </button>
      </form>
    </div>

    @if (Model != null && Model.Count > 0)
    {
      <div class="card" style="background: #FFF; border: 1px solid #E2DACB; border-radius: 8px; padding: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
        <h3 style="font-size: 1.2rem; color: #4A3525; margin-top: 0; margin-bottom: 1.25rem;">Your Submitted Reviews</h3>
        @foreach (var r in Model)
        {
          <div style="border-bottom: 1px solid #ECE4D8; padding: 1rem 0;">
            <div style="color: #D97706; font-size: 1.1rem; margin-bottom: 0.35rem;">
              @(new string('★', r.Rating))@(new string('☆', 5 - r.Rating))
            </div>
            <p style="margin: 0 0 0.35rem 0; color: #333; font-size: 0.95rem; line-height: 1.6;">@r.Text</p>
            <span style="font-size: 0.75rem; color: #888;">📅 @Format.Date(Format.Iso(r.CreatedAt.ToDateTime()))</span>
          </div>
        }
      </div>
    }
  </div>
</div>
