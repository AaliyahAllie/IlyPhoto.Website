@model ClientDashboardViewModel
@{ 
    ViewData["Title"] = "Client Dashboard"; 
}

<div class="container" style="padding: 2.5rem 1rem;">
  <section class="dashboard-head">
    <div>
      <p style="font-size: 0.75rem; letter-spacing: 0.1em; color: #7A6B5D; text-transform: uppercase; font-weight: 700; margin: 0;">CLIENT PORTAL</p>
      <h1 style="font-size: 2.5rem; font-weight: 700; color: #1A1A1A; margin: 0.35rem 0 0.5rem 0;">Welcome, @(User.Identity?.Name ?? "Client")</h1>
      <p style="color: #666; margin: 0;">Your bookings, private photo galleries, and invoices are all in one place.</p>
    </div>
    <a class="btn btn-primary" asp-action="Bookings" style="padding: 0.75rem 1.5rem; text-decoration: none; font-weight: 700;">+ New Booking Request</a>
  </section>

  <section class="dashboard-grid">
    <article class="stat">
      <span>Upcoming Bookings</span>
      <strong>@Model.UpcomingCount</strong>
      <small>@(Model.Next is null ? "None scheduled" : "Next: " + Format.Date(Model.Next.Date))</small>
    </article>

    <article class="stat">
      <span>Outstanding Invoices</span>
      <strong>@Model.OutstandingCount</strong>
      <small>@(Model.OutstandingCount == 0 ? "All settled" : Format.Rand(Model.OutstandingTotal) + " due via EFT")</small>
    </article>

    <article class="stat">
      <span>Private Galleries</span>
      <strong>@Model.GalleryCount</strong>
      <small>@(Model.GalleryCount == 0 ? "Awaiting photographer upload" : "Ready to view & download")</small>
    </article>

    <article class="stat">
      <span>Next Event Status</span>
      @if (Model.Next is null) 
      { 
        <strong>—</strong>
        <small>No upcoming bookings</small> 
      }
      else 
      { 
        <strong class="status @Format.StatusClass(Model.Next.Status)" style="font-size: 1.25rem; margin-top: 0.5rem;">@Model.Next.Status</strong>
        <small>@Model.Next.EventType</small> 
      }
    </article>
  </section>

  <div class="card" style="background: #FFF; border: 1px solid #E2DACB; border-radius: 8px; padding: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03); margin-bottom: 2rem;">
    <h2 style="font-size: 1.4rem; color: #4A3525; margin-bottom: 1rem;">Next Scheduled Event</h2>
    @if (Model.Next is null)
    {
      <p style="color: #666;">You currently have no upcoming events scheduled. <a asp-action="Bookings" style="color: #4A3525; font-weight: 700;">Request a booking</a> to secure your date!</p>
    }
    else
    {
      <div class="event-row" style="border-top: none; padding-top: 0;">
        <div class="date-box">
          <b>@Model.Next.EventDate.Day</b>
          <span>@Model.Next.EventDate.ToString("MMM", System.Globalization.CultureInfo.InvariantCulture).ToUpperInvariant()</span>
        </div>
        <div style="flex: 1;">
          <h3 style="margin: 0 0 0.25rem 0; font-size: 1.2rem;">@Model.Next.EventType</h3>
          <p style="margin: 0; color: #666; font-size: 0.9rem;">
            🕒 @Model.Next.StartTime – @Model.Next.EndTime (@Model.Next.Hours hours) &nbsp;•&nbsp; 📍 @Model.Next.Location
          </p>
          @if (!string.IsNullOrEmpty(Model.Next.Notes))
          {
            <p style="margin: 0.35rem 0 0 0; color: #888; font-size: 0.85rem; font-style: italic;">"@Model.Next.Notes"</p>
          }
        </div>
        <span class="status @Format.StatusClass(Model.Next.Status)">@Model.Next.Status</span>
      </div>
    }
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
    <div class="card" style="background: #FAF7F2; border: 1px solid #E2DACB; border-radius: 8px; padding: 1.5rem;">
      <h3 style="color: #4A3525; margin-top: 0;">📸 Access Private Galleries</h3>
      <p style="color: #666; font-size: 0.9rem;">View high-resolution photography collections uploaded by Aysha Allie for your events, and download full albums in ZIP format.</p>
      <a asp-action="Gallery" class="btn btn-outline btn-sm" style="margin-top: 0.5rem; text-decoration: none;">Go to Galleries →</a>
    </div>

    <div class="card" style="background: #FAF7F2; border: 1px solid #E2DACB; border-radius: 8px; padding: 1.5rem;">
      <h3 style="color: #4A3525; margin-top: 0;">🏦 Invoices & Bank EFT</h3>
      <p style="color: #666; font-size: 0.9rem;">Review tax invoices, access printable banking statement sheets, and make direct EFT payments through your banking app.</p>
      <a asp-action="Invoices" class="btn btn-outline btn-sm" style="margin-top: 0.5rem; text-decoration: none;">View Invoices →</a>
    </div>
  </div>
</div>
