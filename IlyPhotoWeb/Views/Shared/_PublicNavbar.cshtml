<header class="site-navbar" style="background-color: #FDFBF7; border-bottom: 1px solid #E2DACB; position: sticky; top: 0; z-index: 100; padding: 0.75rem 0;">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between;">
        <a asp-controller="Home" asp-action="Index" style="display: flex; align-items: center; text-decoration: none;">
            <img src="~/images/logo.png" alt="Ily Photo - Capture Forever" style="height: 52px; object-fit: contain;" />
        </a>

        <nav>
            <ul style="display: flex; align-items: center; gap: 1.5rem; list-style: none; margin: 0; padding: 0;">
                <li><a asp-controller="Home" asp-action="Index" class="nav-link">Home</a></li>
                <li><a asp-controller="Home" asp-action="Portfolio" class="nav-link">Portfolio</a></li>
                <li><a asp-controller="Home" asp-action="Pricing" class="nav-link">Pricing</a></li>
                <li><a asp-controller="Home" asp-action="Contact" class="nav-link">Contact Us</a></li>
            </ul>
        </nav>

        <div style="display: flex; gap: 0.75rem; align-items: center;">
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline btn-sm">Sign In</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm">Register</a>
        </div>
    </div>
</header>
