@{
    var role = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Client") ? "Client" : null;
    var flashMessages = new[] { "AdminMessage", "BookingMessage", "ReviewMessage", "ProfileMessage", "ContactSuccess" };
    var flashErrors = new[] { "AdminError", "ProfileError" };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ILY PHOTO</title>
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    @if (role == "Admin")
    {
        @await Html.PartialAsync("_AdminNavbar")
    }
    else if (role == "Client")
    {
        @await Html.PartialAsync("_ClientNavbar")
    }
    else
    {
        @await Html.PartialAsync("_PublicNavbar")
    }

    <main class="main-content">
        @foreach (var key in flashMessages)
        {
            if (TempData[key] is string msg)
            {
                <div class="container" style="margin-top: 1.25rem;">
                    <div class="notice flash">@msg</div>
                </div>
            }
        }
        @foreach (var key in flashErrors)
        {
            if (TempData[key] is string err)
            {
                <div class="container" style="margin-top: 1.25rem;">
                    <div class="notice error flash">@err</div>
                </div>
            }
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-column">
                    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
                        <img src="~/images/logo.png" alt="ILY PHOTO" style="height: 48px; object-fit: contain; filter: brightness(0.95);" />
                    </div>
                    <p style="font-size: 0.88rem; color: #666; margin-bottom: 1rem;">
                        Creating timeless memories & capturing high-fashion photography experiences with sophistication.
                    </p>
                    <p style="font-size: 0.8rem; color: #4A3525; font-weight: 600;">
                        🛡️ POPIA Compliant Client Privacy & Data Security
                    </p>
                </div>

                <div class="footer-column">
                    <h4>Explore</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Home" asp-action="Portfolio">Portfolio Showcase</a></li>
                        <li><a asp-controller="Home" asp-action="Pricing">Packages & Pricing</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact & Enquiries</a></li>
                    </ul>
                </div>

                <div class="footer-column">
                    <h4>Client & Management</h4>
                    <ul>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            if (role == "Admin")
                            {
                                <li><a asp-controller="Admin" asp-action="Index">Admin Portal</a></li>
                                <li><a asp-controller="Admin" asp-action="Bookings">Booking Requests</a></li>
                                <li><a asp-controller="Admin" asp-action="Calendar">Photographer Calendar</a></li>
                            }
                            else
                            {
                                <li><a asp-controller="Client" asp-action="Index">Client Dashboard</a></li>
                                <li><a asp-controller="Client" asp-action="Bookings">Book A Session</a></li>
                                <li><a asp-controller="Client" asp-action="Gallery">Private Photo Gallery</a></li>
                            }
                        }
                        else
                        {
                            <li><a asp-controller="Account" asp-action="Login">Client Sign In</a></li>
                            <li><a asp-controller="Account" asp-action="Register">Create Free Account</a></li>
                        }
                    </ul>
                </div>

                <div class="footer-column">
                    <h4>Direct Contact</h4>
                    <ul style="font-size: 0.88rem; color: #666;">
                        <li>✉️ <a href="mailto:info@ilyphoto.co.za" style="color: inherit; text-decoration: none;">info@ilyphoto.co.za</a></li>
                        <li>📞 +27 (0) 82 123 4567</li>
                        <li>📍 Cape Town, Western Cape</li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <p>© @DateTime.Now.Year ILY Photo Studio (Pty) Ltd. All rights reserved. Capture forever.</p>
            </div>
        </div>
    </footer>

    <!-- Global Image Modal for Portfolio & Albums -->
    <div id="imageLightboxModal" class="lightbox-modal" onclick="closeLightbox(event)">
        <span class="lightbox-close">&times;</span>
        <img class="lightbox-content" id="lightboxTargetImg" alt="Enlarged view">
        <div id="lightboxCaption" class="lightbox-caption"></div>
    </div>

    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
