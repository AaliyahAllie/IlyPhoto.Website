@{
    var clientName = User.Identity?.Name ?? "Client";
}

<header class="site-navbar client-navbar">
    <div class="container navbar-flex">
        <a asp-controller="Client" asp-action="Index" class="navbar-brand">
            <img src="~/images/logo.png" alt="Ily Photo - Capture Forever" />
            <span class="portal-tag client-tag">Client Portal</span>
        </a>

        <nav class="navbar-menu">
            <ul>
                <li><a asp-controller="Client" asp-action="Index" class="nav-link">Dashboard</a></li>
                <li><a asp-controller="Client" asp-action="Bookings" class="nav-link">Book Session</a></li>
                <li><a asp-controller="Client" asp-action="Gallery" class="nav-link">Private Gallery</a></li>
                <li><a asp-controller="Client" asp-action="Invoices" class="nav-link">Invoices</a></li>
                <li><a asp-controller="Client" asp-action="Reviews" class="nav-link">Reviews</a></li>
                <li><a asp-controller="Client" asp-action="Profile" class="nav-link">Profile</a></li>
            </ul>
        </nav>

        <div class="navbar-actions">
            <select aria-label="Language Selector" class="lang-selector" onchange="setLanguage(this.value)">
                <option value="en">EN</option>
                <option value="af">AF</option>
            </select>
            <button type="button" class="btn btn-outline btn-sm theme-toggle-btn" onclick="toggleDarkMode()" aria-label="Toggle Dark Mode">
                Dark Mode
            </button>
            <span class="navbar-user">Client: @clientName</span>
            <form method="post" asp-controller="Account" asp-action="Logout" class="navbar-form">
                <button type="submit" class="btn btn-secondary btn-sm">Logout</button>
            </form>
        </div>
    </div>
</header>
