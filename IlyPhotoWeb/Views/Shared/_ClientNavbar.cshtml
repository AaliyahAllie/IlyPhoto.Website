@{
    var clientName = User.Identity?.Name ?? "Client";
}

<header class="site-navbar" style="background-color: #FAF7F2; border-bottom: 2px solid #4A3525; position: sticky; top: 0; z-index: 100; padding: 0.75rem 0;">
    <div class="container" style="display: flex; align-items: center; justify-content: space-between;">
        <!-- Logo click navigates directly to Client Portal Dashboard -->
        <a asp-controller="Client" asp-action="Index" style="display: flex; align-items: center; gap: 0.75rem; text-decoration: none;">
            <img src="~/images/logo.png" alt="Ily Photo - Capture Forever" style="height: 52px; object-fit: contain;" />
            <span style="font-size: 0.75rem; background-color: #4A3525; color: #FFF; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: 700; letter-spacing: 0.05em;">CLIENT PORTAL</span>
        </a>

        <nav>
            <ul style="display: flex; align-items: center; gap: 1.5rem; list-style: none; margin: 0; padding: 0;">
                <li><a asp-controller="Client" asp-action="Index" class="nav-link">Dashboard</a></li>
                <li><a asp-controller="Client" asp-action="Bookings" class="nav-link">Book Session</a></li>
                <li><a asp-controller="Client" asp-action="Gallery" class="nav-link">My Private Gallery</a></li>
                <li><a asp-controller="Client" asp-action="Invoices" class="nav-link">Invoices</a></li>
                <li><a asp-controller="Client" asp-action="Reviews" class="nav-link">Reviews</a></li>
                <li><a asp-controller="Client" asp-action="Profile" class="nav-link">Profile</a></li>
            </ul>
        </nav>

        <div style="display: flex; gap: 0.75rem; align-items: center;">
            <span style="font-size: 0.85rem; color: #4A3525; font-weight: 700;">👤 @clientName</span>
            <form method="post" asp-controller="Account" asp-action="Logout" style="display: inline; margin: 0;">
                <button type="submit" class="btn btn-secondary btn-sm" style="cursor: pointer;">Logout</button>
            </form>
        </div>
    </div>
</header>
