@model ForgotPasswordViewModel
@{ 
    ViewData["Title"] = "Forgot Password"; 
}

<section class="auth-wrap" style="padding: 3rem 1rem; min-height: 75vh; display: flex; align-items: center; justify-content: center;">
  <div class="card" style="max-width: 440px; width: 100%; padding: 2.5rem; background: #FFFFFF; border: 1px solid #E2DACB; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
    <div style="text-align: center; margin-bottom: 1.5rem;">
      <img src="~/images/logo.png" alt="ILY PHOTO" style="height: 60px; object-fit: contain; margin-bottom: 0.5rem;"/>
      <p style="font-size: 0.75rem; letter-spacing: 0.1em; color: #7A6B5D; text-transform: uppercase; font-weight: 700; margin: 0;">PASSWORD RECOVERY</p>
      <h1 style="font-size: 1.8rem; font-weight: 700; color: #1A1A1A; margin: 0.5rem 0 0 0;">Reset Password</h1>
      <p style="font-size: 0.88rem; color: #666; margin: 0.5rem 0 0 0;">Enter your registered email address and choose a new password.</p>
    </div>

    <div asp-validation-summary="All" class="form-errors" style="color: #A93226; font-size: 0.88rem; margin-bottom: 1rem;"></div>

    <form method="post" asp-controller="Account" asp-action="ForgotPassword">
      <div class="form-group" style="margin-bottom: 1.25rem;">
        <label asp-for="Email" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.35rem; color: #4A3525;">Registered Email Address</label>
        <input asp-for="Email" type="email" required autocomplete="username" class="form-control" placeholder="client@example.com" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; font-size: 0.95rem;"/>
      </div>

      <div class="form-group" style="margin-bottom: 1.25rem;">
        <label asp-for="NewPassword" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.35rem; color: #4A3525;">New Password</label>
        <input asp-for="NewPassword" type="password" required autocomplete="new-password" class="form-control" placeholder="Minimum 6 characters" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; font-size: 0.95rem;"/>
      </div>

      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label asp-for="ConfirmNewPassword" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 0.35rem; color: #4A3525;">Confirm New Password</label>
        <input asp-for="ConfirmNewPassword" type="password" required autocomplete="new-password" class="form-control" placeholder="Re-enter new password" style="width: 100%; padding: 0.75rem; border: 1px solid #D1C7B7; border-radius: 4px; font-size: 0.95rem;"/>
      </div>

      <button class="btn btn-primary btn-block" type="submit" style="width: 100%; padding: 0.85rem; font-size: 1rem; font-weight: 700; cursor: pointer;">Save New Password</button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; border-top: 1px solid #ECE4D8; padding-top: 1.25rem; font-size: 0.88rem; color: #666;">
      Remembered your password? <a asp-action="Login" style="color: #4A3525; font-weight: 700; text-decoration: underline;">Return to Sign In</a>
    </div>
  </div>
</section>
