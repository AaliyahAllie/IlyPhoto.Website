@model List<ServicePackage>
@{ 
    ViewData["Title"] = "Service Packages & Pricing"; 
}

<div class="container" style="padding: 2.5rem 1rem;">
  <section class="dashboard-head">
    <div>
      <p style="font-size: 0.75rem; letter-spacing: 0.1em; color: #7A6B5D; text-transform: uppercase; font-weight: 700; margin: 0;">SERVICE CATALOG</p>
      <h1 style="font-size: 2.5rem; font-weight: 700; color: #1A1A1A; margin: 0.35rem 0 0.5rem 0;">Packages & Pricing Rates</h1>
      <p style="color: #666; margin: 0;">These rates power the public Packages page, client booking calculator, and invoice generation.</p>
    </div>
    <button class="btn btn-primary" type="button" onclick="openService(null)" style="padding: 0.75rem 1.25rem;">
      + Add Package
    </button>
  </section>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
  @foreach (var s in Model)
  {
    <div class="card" style="background: #FFF; border: 1px solid #E2DACB; border-radius: 8px; padding: 1.75rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <h3 style="margin: 0; font-size: 1.3rem; color: #1A1A1A;">@s.Name</h3>
          <span class="badge" style="background: #EAE3D2; color: #4A3525; font-size: 0.75rem; font-weight: 700;">
            Order: @s.SortOrder
          </span>
        </div>

        <div style="font-size: 1.6rem; font-weight: 800; color: #4A3525; margin-bottom: 0.5rem;">
          @if (s.HourlyOnly)
          {
            <span>@Format.Rand(s.BasePrice) <small style="font-size: 0.85rem; font-weight: 500; color: #777;">/ hour</small></span>
          }
          else
          {
            <span>@Format.Rand(s.BasePrice) <small style="font-size: 0.85rem; font-weight: 500; color: #777;">for @s.IncludedHours hours</small></span>
          }
        </div>

        @if (!s.HourlyOnly && s.ExtraHourPrice > 0)
        {
          <p style="font-size: 0.85rem; color: #666; margin: 0 0 0.5rem 0;">
            +@Format.Rand(s.ExtraHourPrice) per additional hour
          </p>
        }

        <p style="color: #666; font-size: 0.9rem; line-height: 1.5; margin: 0.5rem 0 1.25rem 0;">
          @s.Description
        </p>
      </div>

      <button type="button" class="btn btn-outline btn-sm"
              data-id="@s.Id" 
              data-name="@s.Name" 
              data-description="@s.Description"
              data-base="@s.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
              data-included="@s.IncludedHours"
              data-extra="@s.ExtraHourPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
              data-hourly="@(s.HourlyOnly ? "1" : "0")" 
              data-sort="@s.SortOrder"
              onclick="openService(this)">
        ✏️ Edit Package Details
      </button>
    </div>
  }
  </div>
</div>

<!-- Modal Dialog to Add / Edit Service Package -->
<dialog id="serviceDialog" style="border: 0; border-radius: 8px; padding: 0; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
  <form method="post" asp-controller="Admin" asp-action="SaveService" class="dialog-card">
    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #E2DACB; padding-bottom: 0.75rem; margin-bottom: 1.25rem;">
      <h2 id="svcTitle" style="color: #4A3525; margin: 0; font-size: 1.35rem;">Edit Package</h2>
      <button type="button" onclick="this.closest('dialog').close()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #777;">✕</button>
    </div>

    <input type="hidden" name="id" id="svcId"/>

    <div class="form-group" style="margin-bottom: 1rem;">
      <label style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Package Name *</label>
      <input name="name" id="svcName" required maxlength="80" class="form-control" style="width: 100%; padding: 0.65rem; border: 1px solid #D1C7B7; border-radius: 4px;"/>
    </div>

    <div class="form-group" style="margin-bottom: 1rem;">
      <label style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Short Description</label>
      <input name="description" id="svcDescription" maxlength="200" class="form-control" style="width: 100%; padding: 0.65rem; border: 1px solid #D1C7B7; border-radius: 4px;"/>
    </div>

    <div class="two" style="margin-bottom: 1rem;">
      <div>
        <label style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Base / Hourly Rate (R) *</label>
        <input name="basePrice" id="svcBase" type="number" min="0" step="0.01" required class="form-control" style="width: 100%; padding: 0.65rem; border: 1px solid #D1C7B7; border-radius: 4px;"/>
      </div>
      <div>
        <label style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Hours Included</label>
        <input name="includedHours" id="svcIncluded" type="number" min="1" max="24" required class="form-control" style="width: 100%; padding: 0.65rem; border: 1px solid #D1C7B7; border-radius: 4px;"/>
      </div>
    </div>

    <div class="two" style="margin-bottom: 1rem;">
      <div>
        <label style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Extra Hour Rate (R)</label>
        <input name="extraHourPrice" id="svcExtra" type="number" min="0" step="0.01" value="0" class="form-control" style="width: 100%; padding: 0.65rem; border: 1px solid #D1C7B7; border-radius: 4px;"/>
      </div>
      <div>
        <label style="display: block; font-size: 0.88rem; font-weight: 600; color: #4A3525; margin-bottom: 0.35rem;">Display Order</label>
        <input name="sortOrder" id="svcSort" type="number" value="10" class="form-control" style="width: 100%; padding: 0.65rem; border: 1px solid #D1C7B7; border-radius: 4px;"/>
      </div>
    </div>

    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; color: #333; cursor: pointer;">
        <input type="checkbox" name="hourlyOnly" id="svcHourly" value="true" style="width: 18px; height: 18px; accent-color: #4A3525;"/>
        <span>Charge strictly per hour (e.g. Other Events / Birthdays)</span>
      </label>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
      <button class="btn btn-outline" type="button" onclick="this.closest('dialog').close()">Cancel</button>
      <button class="btn btn-primary" type="submit">Save Package</button>
    </div>
  </form>
</dialog>

@section Scripts {
<script>
function openService(btn) {
  const g = id => document.getElementById(id);
  g('svcTitle').textContent = btn ? 'Edit Package' : 'Add Package';
  g('svcId').value = btn ? btn.dataset.id : '';
  g('svcName').value = btn ? btn.dataset.name : '';
  g('svcDescription').value = btn ? btn.dataset.description : '';
  g('svcBase').value = btn ? btn.dataset.base : '';
  g('svcIncluded').value = btn ? btn.dataset.included : 1;
  g('svcExtra').value = btn ? btn.dataset.extra : 0;
  g('svcSort').value = btn ? btn.dataset.sort : 10;
  g('svcHourly').checked = btn ? btn.dataset.hourly === '1' : false;
  g('serviceDialog').showModal();
}
</script>
}
