@model List<Review>
@{ 
    ViewData["Title"] = "Client Reviews Admin"; 
}

<div class="container" style="padding: 2.5rem 1rem;">
  <section class="dashboard-head">
    <div>
      <p style="font-size: 0.75rem; letter-spacing: 0.1em; color: #7A6B5D; text-transform: uppercase; font-weight: 700; margin: 0;">QUALITY & FEEDBACK</p>
      <h1 style="font-size: 2.5rem; font-weight: 700; color: #1A1A1A; margin: 0.35rem 0 0.5rem 0;">Client Reviews & Ratings</h1>
      <p style="color: #666; margin: 0;">Feedback submitted by registered clients after photography sessions.</p>
    </div>
  </section>

  <div class="card" style="background: #FFF; border: 1px solid #E2DACB; border-radius: 8px; padding: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
    @if (Model.Count == 0)
    {
      <p style="color: #3D3D3D; margin: 0;">No client reviews recorded in Azure Table Storage yet.</p>
    }
    else
    {
      <div style="display: grid; gap: 1.25rem;">
      @foreach (var r in Model)
      {
        <div style="border-bottom: 1px solid #ECE4D8; padding-bottom: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
            <div>
              <strong style="color: #1A1A1A; font-size: 1.05rem;">@r.ClientName</strong>
              <small style="color: #777;">(@r.ClientId)</small>
            </div>
            <div style="color: #D97706; font-size: 1.1rem;">
              @(new string('★', r.Rating))@(new string('☆', 5 - r.Rating))
            </div>
          </div>
          <p style="color: #444; font-size: 0.95rem; line-height: 1.6; margin: 0 0 0.5rem 0;">"@r.Text"</p>
          <span style="font-size: 0.75rem; color: #888;">📅 Submitted: @Format.Date(Format.Iso(r.CreatedAt.ToDateTime()))</span>
        </div>
      }
      </div>
    }
  </div>
</div>
