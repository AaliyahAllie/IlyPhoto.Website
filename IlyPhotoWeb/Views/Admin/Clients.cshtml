@model List<ClientRow>
@{ 
    ViewData["Title"] = "Registered Clients"; 
}

<div class="container" style="padding: 2.5rem 1rem;">
  <section class="dashboard-head">
    <div>
      <p style="font-size: 0.85rem; letter-spacing: 0.1em; color: #4A3525; text-transform: uppercase; font-weight: 700; margin: 0;">CLIENT MANAGEMENT</p>
      <h1 style="font-size: 2.5rem; font-weight: 700; color: #1A1A1A; margin: 0.35rem 0 0.5rem 0;">Client Directory</h1>
      <p style="color: #3D3D3D; margin: 0;">View all registered clients, booking counts, and contact records stored in Azure Table Storage (<code>ilyphotostorage</code>).</p>
    </div>
  </section>

  <div class="card" style="background: #FFF; border: 1px solid #E2DACB; border-radius: 8px; padding: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
    <div class="table-wrap">
      <table class="table" style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="background-color: #FAF7F2; border-bottom: 2px solid #E2DACB; text-align: left;">
            <th style="padding: 12px;">Client ID</th>
            <th style="padding: 12px;">Full Name</th>
            <th style="padding: 12px;">Email Address</th>
            <th style="padding: 12px;">Phone / WhatsApp</th>
            <th style="padding: 12px;">Total Bookings</th>
            <th style="padding: 12px;">Last Activity</th>
          </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
          <tr style="border-bottom: 1px solid #ECE4D8;">
            <td style="padding: 12px; font-weight: 700; color: #4A3525;">@r.Profile.ClientId</td>
            <td style="padding: 12px; font-weight: 600;">@r.Profile.FullName</td>
            <td style="padding: 12px;"><a href="mailto:@r.Profile.Email" style="color: inherit;">@r.Profile.Email</a></td>
            <td style="padding: 12px;">@(string.IsNullOrWhiteSpace(r.Profile.Phone) ? "—" : r.Profile.Phone)</td>
            <td style="padding: 12px; font-weight: 700;">@r.BookingCount</td>
            <td style="padding: 12px; color: #666;">@r.LastActivity</td>
          </tr>
        }
        @if (Model.Count == 0)
        {
          <tr><td colspan="6" style="padding: 20px; text-align: center; color: #777;">No clients have registered yet.</td></tr>
        }
        </tbody>
      </table>
    </div>
  </div>
</div>
